  "entries": [
    {
      "narrativeId": "story_001_dream",
      "once": true,
      "sequence": true,
      "blocking": true,
      "priority": 30,
      "animations": [
        { "type": "screen_flash", "colour": "#000000", "duration": 1000 },
        { "type": "dialogue" }
      ],
      "lines": [
        { "speakerId": "THE CREATOR", "text": "Oh. There you are." },
        { "speakerId": "THE CREATOR", "text": "I have been looking at everything. Galaxies. Equations. The space between atoms. None of it looked back." },
        { "speakerId": "THE CREATOR", "text": "You looked back." },
        { "speakerId": "???",         "text": "...where am I." },
        { "speakerId": "THE CREATOR", "text": "That is a good question. I have been asking it for longer than your species has had language." },
        { "speakerId": "THE CREATOR", "text": "What is your name?" },
        { "speakerId": "???",         "text": "I — I can't —" },
        { "speakerId": "THE CREATOR", "text": "It doesn't matter yet. I will find it." },
        { "speakerId": "THE CREATOR", "text": "Something is happening on the red world. You will be near it. I don't know why you specifically." },
        { "speakerId": "THE CREATOR", "text": "I find that interesting." },
        { "speakerId": "THE CREATOR", "text": "I will be watching." }
      ]
    },
    {
      "narrativeId": "story_001_victory",
      "trigger": { "event": "battle_victory" },
      "once": true,
      "sequence": true,
      "blocking": true,
      "priority": 20,
      "animations": [
        { "type": "screen_flash", "colour": "var(--accent-heal)", "duration": 600 },
        { "type": "dialogue" }
      ],
      "lines": [
        { "speakerId": "husty_001", "text": "Hostiles neutralised. Signal source is still transmitting." },
        { "speakerId": "hugo_001",  "text": "We're not done. Keep moving." }
      ]
    },
    {
      "narrativeId": "story_001_defeat",
      "trigger": { "event": "battle_defeat" },
      "once": true,
      "sequence": true,
      "blocking": true,
      "priority": 20,
      "animations": [
        { "type": "screen_flash", "colour": "var(--accent-danger)", "duration": 1000 },
        { "type": "dialogue" }
      ],
      "lines": [
        { "speakerId": "husty_001", "text": "Retreat vector calculated. We regroup." },
        { "speakerId": "hugo_001",  "text": "Fall back. Now." }
      ]
    }
  ]
