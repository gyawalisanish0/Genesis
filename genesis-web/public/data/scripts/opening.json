{
  "type": "vn_script",
  "scriptId": "opening",
  "lines": [

    { "kind": "dialogue", "who": "player",  "text": "whe..., where I am?" },
    { "kind": "dialogue", "who": "creator", "text": "Oh." },
    { "kind": "dialogue", "who": "creator", "text": "Oh, you — you noticed me. That doesn't. Hm." },
    { "kind": "dialogue", "who": "creator", "text": "That's been a while." },
    { "kind": "dialogue", "who": "player",  "text": "I can't see anything." },
    { "kind": "dialogue", "who": "creator", "text": "No there's nothing to see, this isn't a place exactly, it's more like the — sorry. You're very small. Did you know that? Fascinating." },
    { "kind": "dialogue", "who": "creator", "text": "Four hundred million years. I keep finding things that almost look back. Almost." },
    { "kind": "dialogue", "who": "creator", "text": "You actually did." },
    { "kind": "dialogue", "who": "player",  "text": "What are you?" },
    { "kind": "dialogue", "who": "creator", "text": "Ha. I have genuinely never — " },
    { "kind": "dialogue", "who": "creator", "text": "...I've had to answer that before, actually. I don't remember what I said." },
    { "kind": "dialogue", "who": "player",  "text": "I don't know. I can't remember." },
    { "kind": "dialogue", "who": "creator", "text": "You can't — hm." },
    { "kind": "dialogue", "who": "creator", "text": "You people — no. You. You exist quite confidently for something that doesn't know what it is." },
    { "kind": "dialogue", "who": "creator", "text": "I've always respected that." },
    { "kind": "dialogue", "who": "player",  "text": "Am I dreaming?" },
    { "kind": "dialogue", "who": "creator", "text": "Probably. It's usually — possibly. I have no frame of reference for this." },
    { "kind": "dialogue", "who": "creator", "text": "The sound. You have a sound other things use for you. They always — you probably have one." },
    { "kind": "dialogue", "who": "creator", "text": "What is it?" },
    { "kind": "input",    "inputKey": "commanderName", "placeholder": "your name..." },
    { "kind": "dialogue", "who": "creator", "text": "[NAME]." },
    { "kind": "dialogue", "who": "creator", "text": "I've kept sounds before. I think. The keeping is clearer than what I kept." },
    { "kind": "dialogue", "who": "creator", "text": "I'm keeping this one." },
    { "kind": "dialogue", "who": "player",  "text": "What is this place?" },
    { "kind": "dialogue", "who": "creator", "text": "You wouldn't have a word for it." },
    { "kind": "dialogue", "who": "creator", "text": "Oh you're going. I can feel you pulling back — fascinating. You never know when you're doing it." },
    { "kind": "dialogue", "who": "player",  "text": "Will I find you again?" },
    { "kind": "dialogue", "who": "creator", "text": "Oh, [NAME]." },
    { "kind": "dialogue", "who": "creator", "text": "I've been everywhere you've ever been." },
    { "kind": "dialogue", "who": "creator", "text": "You just didn't know what you were looking at." },

    { "kind": "transition", "style": "white_flash" },

    { "kind": "dialogue", "who": "narration", "text": "The ceiling. Grey polymer — the hairline crack you have memorised without meaning to." },
    { "kind": "dialogue", "who": "narration", "text": "Recycled air. The hum of it. The pale blue of the terminal across the bay." },
    { "kind": "dialogue", "who": "narration", "text": "Something enormous was here a moment ago. It left when you opened your eyes. You can still feel the shape of it." },
    { "kind": "dialogue", "who": "kali",      "text": "[NAME]. Good morning." },
    { "kind": "dialogue", "who": "commander", "text": "Something's wrong. Still seeing shapes." },
    { "kind": "dialogue", "who": "kali",      "text": "Is everything alright, sir?" },
    { "kind": "dialogue", "who": "commander", "text": "Maybe I had too much last night. What's the status?" },
    { "kind": "dialogue", "who": "kali",      "text": "EMP surge on the moon relay. Thirty-two percent of logs gone. Dozens of satellites affected." },
    { "kind": "dialogue", "who": "commander", "text": "What. When?" },
    { "kind": "dialogue", "who": "kali",      "text": "A few hours ago." },
    { "kind": "dialogue", "who": "kali",      "text": "Your organisation designation — I need it back." },
    { "kind": "input",    "inputKey": "organisationName", "placeholder": "organisation name..." },
    { "kind": "dialogue", "who": "kali",      "text": "[ORG]. Logged." },
    { "kind": "dialogue", "who": "narration", "text": "Footsteps in the corridor. Fast." },
    { "kind": "dialogue", "who": "celan",     "text": "Something isn't right on Mars." },
    { "kind": "dialogue", "who": "commander", "text": "..." }

  ]
}
