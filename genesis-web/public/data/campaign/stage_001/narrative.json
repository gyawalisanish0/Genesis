{
  "type": "narrative",
  "levelId": "stage_001",
  "entries": [
    {
      "narrativeId": "stage_001_intro",
      "once": true,
      "sequence": true,
      "blocking": true,
      "priority": 20,
      "animations": [{ "type": "dialogue" }],
      "lines": [
        { "speakerId": "celan_001",  "text": "Hugo, are you there?" },
        { "speakerId": "hugo_001",   "text": "Just landed. Strong radio signal nearby." },
        { "speakerId": "celan_001",  "text": "Report anything, ASAP." },
        { "speakerId": "hugo_001",   "text": "Husty, ready? Navigation is down. I think we should explore." },
        { "speakerId": "tara_001",   "text": "Let's go then." }
      ]
    },
    {
      "narrativeId": "stage_001_tutorial_move",
      "once": true,
      "sequence": true,
      "animations": [{ "type": "dialogue" }],
      "lines": [
        { "speakerId": "husty_001", "text": "Tap the arrows to move. One tile per action. Fog lifts as you advance." },
        { "speakerId": "hugo_001",  "text": "Fog means unknowns. Don't rush." }
      ]
    },
    {
      "narrativeId": "stage_001_tutorial_combat",
      "once": true,
      "sequence": true,
      "animations": [{ "type": "dialogue" }],
      "lines": [
        { "speakerId": "husty_001", "text": "Patrol ahead. I've already mapped their detection radius. Two safe corridors." },
        { "speakerId": "hugo_001",  "text": "If they spot us we hold ground. No retreating in a corridor." }
      ]
    },
    {
      "narrativeId": "stage_001_guard_spotted",
      "once": false,
      "animations": [
        { "type": "screen_flash", "colour": "var(--accent-danger)", "duration": 400 },
        { "type": "floating_text", "text": "SPOTTED!", "colour": "var(--accent-danger)" }
      ]
    },
    {
      "narrativeId": "stage_001_first_chest",
      "once": true,
      "animations": [
        { "type": "floating_text", "text": "SUPPLIES FOUND", "colour": "var(--accent-gold)" }
      ]
    },
    {
      "narrativeId": "stage_001_elder_greeting",
      "once": true,
      "sequence": true,
      "priority": 10,
      "animations": [{ "type": "dialogue" }],
      "lines": [
        { "speakerId": "hugo_001",  "text": "What happened here?" },
        { "speakerId": "husty_001", "text": "Residual energy signatures are inconsistent with Netrolume standard equipment. Whatever came through the eastern pass — it wasn't a grunt squad." },
        { "speakerId": "hugo_001",  "text": "We file the report after we're out. Move." }
      ]
    },
    {
      "narrativeId": "stage_001_exit_reached",
      "once": true,
      "sequence": true,
      "priority": 20,
      "animations": [{ "type": "dialogue" }],
      "lines": [
        { "speakerId": "husty_001", "text": "Exit confirmed. All units accounted for." },
        { "speakerId": "hugo_001",  "text": "Stage clear. We push deeper." }
      ]
    }
  ]
}
