{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd genesis-web && npm ci",
  "buildCommand": "cd genesis-web && npm run build -- --base=/",
  "outputDirectory": "genesis-web/dist",
  "rewrites": [
    { "source": "/((?!assets/|data/|images/|audio/|manifest.json|favicon.ico).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/data/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}
